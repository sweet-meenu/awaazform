# Copy to backend/.env. If absent, the backend also reads apps/web/.env.local.
GROQ_API_KEY=
GROQ_CHAT_MODEL=openai/gpt-oss-120b
GROQ_CHAT_FALLBACK=openai/gpt-oss-20b
GROQ_STT_MODEL=whisper-large-v3-turbo
# Optional: Groq's English voice (needs its terms accepted in the Groq console). Local voices take precedence.
GROQ_TTS_MODEL=
GROQ_TTS_VOICE=

# Origins allowed to call the API (the Next.js app). The extension is allowed too; pin it with AWAAZ_EXTENSION_IDS.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
AWAAZ_EXTENSION_IDS=

# Local speech output: Kokoro for en/hi, MMS-TTS for the other languages.
LOCAL_TTS=1
# Voices loaded at startup (comma-separated). Add the languages you will demo.
TTS_PRELOAD=en,hi
# kokoro-v1.0.int8.onnx is smaller and a little faster, slightly lower quality.
KOKORO_MODEL=kokoro-v1.0.onnx
KOKORO_VOICE_EN=af_heart
KOKORO_VOICE_HI=hf_alpha
