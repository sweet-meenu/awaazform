# Server only. Never prefix with NEXT_PUBLIC_.
GROQ_API_KEY=

# Model names: verify against Groq's console before use (PRD §17).
GROQ_STT_MODEL=whisper-large-v3-turbo
# A tool-capable chat model, e.g. one listed under "tool use" in Groq's docs.
GROQ_CHAT_MODEL=openai/gpt-oss-120b

# Leave empty to use the browser's speechSynthesis for read-back.
GROQ_TTS_MODEL=
GROQ_TTS_VOICE=

# Request limits (bytes and characters)
MAX_AUDIO_BYTES=2000000
MAX_CHAT_INPUT_CHARS=2000
